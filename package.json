{
  "name": "dsh-zolin",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm -r test",
    "models:update": "pnpm --filter dsh-model-accounts models:update",
    "ci": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "eslint": "^10.13.0",
    "js-yaml": "^4.3.2",
    "tsdown": "0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
