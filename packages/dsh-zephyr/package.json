{
  "name": "@liyang8246/dsh-zephyr",
  "type": "module",
  "version": "0.1.3",
  "description": "Standalone Zephyr coding preset, persona and slim tool set for DeepSeek Harness.",
  "repository": { "type": "git", "url": "https://github.com/liyang8246/dsh-zolin.git", "directory": "packages/dsh-zephyr" },
  "exports": {
    "./uv-run": "./lib/uv-run.js",
    "./restrict": "./lib/restrict.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "lib/",
    "locale/*.json"
  ],
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.1-rc.5 <0.3.0" },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
